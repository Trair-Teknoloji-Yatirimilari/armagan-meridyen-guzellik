# Armağan Egemen Güzellik — ortam değişkenleri örneği
#
# Gerçek değerler YALNIZCA .env dosyasında tutulur. .env depoya girmez
# (.gitignore'da) ve hiçbir değer kaynak koda yazılmaz.
#
# Not: Bu site veritabanı kullanmaz. Blog modülü kapalıdır, yönetim paneli
# yoktur; bu yüzden DATABASE_URL benzeri bir değişken bilinçli olarak yoktur.

# Uygulamanın dinleyeceği port (varsayılan 3000)
PORT=3000

# Ters vekil (nginx vb.) arkasında sunucu fonksiyonlarına izin verilen dış
# adresler. Virgülle ayrılır. Örn: https://ornek-alan-adi.com
ALLOWED_ORIGINS=

# İletişim formu ileride e-posta ile de teslim edilmek istenirse alıcı adres.
# BOŞ bırakıldığında form hiçbir sunucuya veri göndermez, WhatsApp'a yönlenir.
# (Mevcut davranış budur.)
CONTACT_FORM_TO=
